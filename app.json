{
  "expo": {
    "name": "cPod Precificador",
    "slug": "cpod-precificador",
    "version": "0.1.0",
    "description": "Ferramenta gratuita para empreendedores precificarem melhor seus produtos e serviços.",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.cpod.precificador"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#071e1d"
      },
      "package": "br.com.cpod.precificador",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "7fa05d4f-58a2-4204-938b-c5b3a43228d9"
      }
    },
    "owner": "valkhan-tech",
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#071e1d"
        }
      ]
    ]
  }
}
